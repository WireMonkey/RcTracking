@using RcTracking.UI.Events
@using RcTracking.UI.Interface
@using RcTracking.UI.Services
<h3>Recently Flown Planes</h3>
@if (showChart)
{
	<MudHidden Breakpoint="Breakpoint.LgAndUp" Invert="true">
		<MudChart ChartType="ChartType.StackedBar" ChartSeries="@Series" XAxisLabels="@Labels" Width="100%" Height="20vh" ChartOptions="@chartOptions" AxisChartOptions="@axisChartOptions"></MudChart>
	</MudHidden>
	<MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
		<div class="chart-responsive">
			<MudChart ChartType="ChartType.StackedBar" ChartSeries="@Series" XAxisLabels="@Labels" Width="100%" Height="100%" ChartOptions="@chartOptions" AxisChartOptions="@axisChartOptions"></MudChart>
		</div>
	</MudHidden>
}
else
{
	<p>No data to display</p>
}

@code {
	[Inject]
	private ICombineDataService CombineDataService { get; set; }

	[Inject]
	private IPlaneService PlaneService { get; set; }

	[Inject]
	private IFlightService FlightService { get; set; }

	[Inject]
	private EventBus EventBus { get; set; }

	[Parameter]
	public int MonthsToShow { get; set; } = 2;

	private List<ChartSeries> Series { get; set; } = new();

	private string[] Labels { get; set; }

	private ChartOptions chartOptions { get; set; } = new();

	private AxisChartOptions axisChartOptions { get; set; } = new();

	private bool showChart = false;

	protected override async Task OnInitializedAsync()
	{
		EventBus.OnMessage += OnMessage;
		chartOptions.YAxisTicks = 1;
		chartOptions.MaxNumYAxisTicks = 10;
		axisChartOptions.MatchBoundsToSize = true;
		axisChartOptions.StackedBarWidthRatio = .8;
		axisChartOptions.XAxisLabelRotation = 10;

		if (PlaneService.HasLoaded && FlightService.HasLoaded)
		{
			UpdateChartData();
		}
	}

	private void OnMessage(object? sender, EventMessage? e)
	{
		switch (e?.Event)
		{
			case EventEnum.StatsUpdated:
				UpdateChartData();
				InvokeAsync(StateHasChanged);
				break;
			default:
				break;
		}
	}

	private void UpdateChartData()
	{
		var planeSeries = new Dictionary<Guid, (string Name, int Count)>();
		planeSeries.EnsureCapacity(5);

		for (int i = MonthsToShow; i >= 0; i--)
		{
			var cDate = DateTime.Now.AddMonths(-i);
			var cMonth = new DateTime(cDate.Year, cDate.Month, 1);
			CombineDataService.MonthyStats.TryGetValue(DateOnly.FromDateTime(cMonth), out var monthData);

			if (monthData is not null) {
				foreach (var flight in monthData)
				{
					var planeName = PlaneService.Planes[flight.Key].Name;
					if (planeSeries.ContainsKey(flight.Key))
					{
						planeSeries[flight.Key] = (planeName, planeSeries[flight.Key].Count + flight.Value);
					}
					else if (planeSeries.Count < 5) //Only show the top 5 planes in the chart, but still count all planes in the data
					{
						planeSeries[flight.Key] = (planeName, flight.Value);
					}
				}
			}
		}

		if (planeSeries.Count == 0)
		{
			Series.Clear();
			showChart = false;
			return;
		}

		Labels = new string[planeSeries.Count];

		var series = new ChartSeries
		{
			Name = "Flights",
			Data = new double[planeSeries.Count]
		};


		for (int i = 0; i < planeSeries.Count; i++)
		{
			var cPlane = planeSeries.ElementAt(i);
			var plane = PlaneService.Planes[cPlane.Key];
			Labels[i] = plane.Name;

			series.Data[i] = cPlane.Value.Count;
		}

		Series.Add(series);

		showChart = true;
	}

}
